---
import Layout from '../layouts/Layout.astro';
const pageTitle = "Home";
---
<Layout pageTitle={pageTitle}>
    <div class="gif">
        <img width="300" height="259" alt="RaccoonSpaceGif" src="/space.webp"/>
    </div>
    <h1>Ash Hong</h1>
    <span class="badge">MIT Computer Science and Engineering</span>
    <h2>About</h2>
    <p>
        Hello! My name is Ash Hong, a MEng student at the Massachusetts Institute of Technology, 
        pursuing a M.E. in Computer Science and Engineering. Feel free to check out my portfolio
        or contact me at any of the links below!
    </p>
    <div class="center">
        <a href="/works/">
            <button class="btn">My Portfolio</button>
        </a>
    </div>
    <h2>Skills</h2>
    <div class="skills center">
        <img class="skills__img" width="46" height="46" alt="C" src="https://thumb.wikimedia.org/wikipedia/commons/thumb/1/18/C_Programming_Language.svg/1920px-C_Programming_Language.svg.png?utm_source=commons.wikimedia.org&utm_campaign=index&utm_content=thumbnail"/>
        <img class="skills__img" width="46" height="46" alt="C#" src="https://upload.wikimedia.org/wikipedia/commons/4/4f/Csharp_Logo.png?utm_source=commons.wikimedia.org&utm_campaign=index&utm_content=original"/>
        <img class="skills__img" width="46" height="46" alt="C++" src="https://upload.wikimedia.org/wikipedia/commons/1/18/ISO_C%2B%2B_Logo.svg"/>
        <img class="skills__img" width="46" height="46" alt="CSS" src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/css3/css3-original.svg"/>
        <img class="skills__img" width="46" height="46" alt="HTML" src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/html5/html5-original.svg"/>
        <img class="skills__img" width="46" height="46" alt="Python" src="https://thumb.wikimedia.org/wikipedia/commons/thumb/c/c3/Python-logo-notext.svg/1280px-Python-logo-notext.svg.png?utm_source=en.wikipedia.org&utm_campaign=index&utm_content=thumbnail"/>
        <img class="skills__img" width="46" height="46" alt="Perforce" src="https://thumb.wikimedia.org/wikipedia/commons/thumb/e/eb/Logo-perforce-icon-reg.svg/3840px-Logo-perforce-icon-reg.svg.png?utm_source=commons.wikimedia.org&utm_campaign=index&utm_content=thumbnail"/>
        <img class="skills__img" width="46" height="46" alt="Blender" src="https://www.iconarchive.com/download/i98223/dakirby309/simply-styled/Blender.ico"/>
        <img class="skills__img" width="46" height="46" alt="Adobe Premiere Pro" src="https://thumb.wikimedia.org/wikipedia/commons/thumb/4/40/Adobe_Premiere_Pro_CC_icon.svg/3840px-Adobe_Premiere_Pro_CC_icon.svg.png?utm_source=commons.wikimedia.org&utm_campaign=index&utm_content=thumbnail"/>
    </div>
</Layout>

